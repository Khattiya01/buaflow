{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buaflow.dev/schemas/pack-v1.json",
  "title": "Buaflow stack/capability pack v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "name",
    "version",
    "inputs",
    "generatedArtifacts",
    "compatibility",
    "verification",
    "upgrade",
    "operationalEvidence"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "_": { "type": "string" },
    "_rules": { "type": "array", "items": { "type": "string" } },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "kind": { "enum": ["stack", "capability"] },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" } },
    "generatedArtifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/generatedArtifact" } },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "verification": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/verificationStep" } },
    "upgrade": { "type": "array", "items": { "$ref": "#/$defs/upgradeStep" } },
    "operationalEvidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/operationalEvidence" } }
  },
  "additionalProperties": false,
  "$defs": {
    "input": {
      "type": "object",
      "required": ["name", "type", "required", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
        "type": { "enum": ["string", "boolean", "number", "enum"] },
        "required": { "type": "boolean" },
        "default": {},
        "options": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "if": { "properties": { "type": { "const": "enum" } }, "required": ["type"] },
      "then": { "required": ["options"] }
    },
    "generatedArtifact": {
      "type": "object",
      "required": ["path", "description"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": ["requiresPacks", "conflictsWithPacks", "profiles"],
      "properties": {
        "requiresPacks": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" } },
        "conflictsWithPacks": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" } },
        "profiles": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" } }
      },
      "additionalProperties": false
    },
    "verificationStep": {
      "type": "object",
      "required": ["id", "command", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "command": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "upgradeStep": {
      "type": "object",
      "required": ["from", "to", "breaking", "steps"],
      "properties": {
        "from": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "to": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "breaking": { "type": "boolean" },
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "operationalEvidence": {
      "type": "object",
      "required": ["control", "evidence"],
      "properties": {
        "control": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "evidence": { "type": "string", "minLength": 20 }
      },
      "additionalProperties": false
    }
  }
}
