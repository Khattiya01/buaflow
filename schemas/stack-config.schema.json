{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buaflow.dev/schemas/stack-config-v1.json",
  "title": "Buaflow stack config v1",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "$comment": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "assuranceMode": { "enum": ["adoption", "production"] },
    "readinessLevel": { "enum": ["R3", "R4"] },
    "readinessManifest": { "type": "string", "minLength": 1 },
    "verifyCommand": { "type": ["string", "null"] },
    "commands": {
      "type": "object",
      "additionalProperties": { "type": ["string", "null"] }
    },
    "auditMode": { "enum": ["warn", "required", "off"] },
    "secretsMode": { "enum": ["warn", "required", "off"] },
    "codeFilePattern": { "type": "string" },
    "formattablePattern": { "type": "string" },
    "skipPattern": { "type": "string" },
    "testFilePattern": { "type": "string" },
    "bugfixBranchPattern": { "type": "string" },
    "preflightHookPath": { "type": "string" },
    "ciMode": { "enum": ["required", "pr-only", "local-only"] },
    "formatCommands": {
      "type": "array",
      "items": { "$ref": "#/$defs/formatCommand" }
    },
    "protected": {
      "type": "array",
      "items": { "$ref": "#/$defs/protectedPath" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "formatCommand": {
      "type": "object",
      "required": ["when", "cmd", "args"],
      "properties": {
        "id": { "type": "string" },
        "when": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "match": { "type": "string" },
        "cmd": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "exclusive": { "type": "boolean" },
        "reportOutput": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "protectedPath": {
      "type": "object",
      "required": ["pattern", "reason"],
      "properties": {
        "pattern": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}

