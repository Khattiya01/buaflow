{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buaflow.dev/schemas/schema-registry-v1.json",
  "title": "Buaflow artifact schema registry",
  "type": "object",
  "required": ["schemaVersion", "artifacts"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "classification", "latestVersion", "schema", "paths", "migration"],
        "properties": {
          "type": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "classification": { "enum": ["public", "internal"] },
          "latestVersion": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+$" },
          "schema": { "type": "string", "minLength": 1 },
          "paths": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "migration": { "enum": ["supported", "manual", "none"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

