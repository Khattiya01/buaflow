{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buaflow.dev/schemas/application-profile-v1.json",
  "title": "Buaflow application profile v1",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "controls", "architectureChoices", "clarificationQuestions"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "_": { "type": "string" },
    "_rules": { "type": "array", "items": { "type": "string" } },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controlOverride" }
    },
    "architectureChoices": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/architectureChoice" }
    },
    "clarificationQuestions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/clarificationQuestion" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "controlOverride": {
      "type": "object",
      "required": ["control", "requirement", "rationale"],
      "properties": {
        "control": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "requirement": { "enum": ["required", "not-applicable"] },
        "rationale": { "type": "string", "minLength": 20 }
      },
      "additionalProperties": false
    },
    "architectureChoice": {
      "type": "object",
      "required": ["area", "choice", "rationale"],
      "properties": {
        "area": { "type": "string", "minLength": 1 },
        "choice": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "clarificationQuestion": {
      "type": "object",
      "required": ["id", "prompt", "affects", "whyItMatters"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "prompt": { "type": "string", "minLength": 1 },
        "affects": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["architecture", "security", "cost", "compliance", "ux"] }
        },
        "whyItMatters": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
