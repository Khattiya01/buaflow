{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buaflow.dev/schemas/security-baseline-v1.json",
  "title": "Buaflow security baseline v1",
  "description": "The threat boundaries of one project, and every control of a named external control set answered for: met with evidence, not met with a recorded exception, or not applicable with a reason. Before this artifact the security-controls control at R3 was satisfied by prose, and a knowingly unmet control had nowhere to go.",
  "type": "object",
  "required": ["schemaVersion", "project", "generatedAt", "controlSet", "boundaries", "controls"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "_": { "type": "string" },
    "project": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "controlSet": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$" },
    "excludedChapters": {
      "type": "array",
      "items": { "$ref": "#/$defs/exclusion" }
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/boundary" }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/control" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "exclusion": {
      "description": "A whole chapter ruled out at once, so a 70-line baseline does not become 70 identical not-applicable rows. The reason must say why the chapter cannot apply, not that answering it was inconvenient.",
      "type": "object",
      "required": ["chapter", "reason"],
      "properties": {
        "chapter": { "type": "string", "pattern": "^V[0-9]+$" },
        "reason": { "type": "string", "minLength": 20 }
      },
      "additionalProperties": false
    },
    "boundary": {
      "description": "Where untrusted input becomes trusted. Recorded as data rather than prose so a reviewer can check that the code named here still exists and still does the check.",
      "type": "object",
      "required": ["id", "name", "untrusted", "trusted", "assets", "entryPoints", "enforcedBy"],
      "properties": {
        "id": { "type": "string", "pattern": "^TB-[0-9]{3,}$" },
        "name": { "type": "string", "minLength": 1 },
        "untrusted": { "type": "string", "minLength": 10 },
        "trusted": { "type": "string", "minLength": 10 },
        "assets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "entryPoints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "enforcedBy": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      },
      "additionalProperties": false
    },
    "control": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^V[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "status": { "enum": ["met", "not-met", "not-applicable"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "exception": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$" },
        "rationale": { "type": "string", "minLength": 20 },
        "note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "enum": ["command", "file", "url", "manual"] },
        "value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
