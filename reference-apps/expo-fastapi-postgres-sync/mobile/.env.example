# EXPO_PUBLIC_-prefixed vars are inlined into the client bundle at build time (Expo's
# documented mechanism for client-side config — see https://docs.expo.dev/guides/environment-variables/).
# Never put a secret here: this value ships inside the app binary and the web bundle.
#
# Web target: the backend serves the built web app itself (see ../Dockerfile), so a relative
# path ("") is correct and this can be left unset.
# Native target (iOS/Android): there is no "same origin" to be relative to — this MUST be
# set to the backend's real reachable URL before building.
EXPO_PUBLIC_API_URL=http://localhost:8000
