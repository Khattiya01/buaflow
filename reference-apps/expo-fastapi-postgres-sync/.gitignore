# dependencies / virtualenvs
backend/.venv/
backend/.venv-prod/
**/__pycache__/
*.pyc
backend/*.egg-info/
backend/build/
mobile/node_modules/
tests/e2e/node_modules/

# local tool settings, not part of the app
**/.claude/

# build output (regenerated by scripts/build-static.mjs and the Dockerfile)
mobile/dist/
mobile/.expo/
mobile/android/
backend/static/

# env files (can opt-in for committing if needed)
**/.env
**/.env.*
!**/.env.example

# playwright (raw HTML report is large/regenerable; evidence/ holds the committed JSON
# summary instead)
tests/e2e/playwright-report/
tests/e2e/test-results/

# misc
.DS_Store
*.tsbuildinfo
*.apk
