{
  "name": "nextjs-postgres-crud",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.mjs",
    "test": "vitest run --config vitest.config.mts",
    "test:integration": "npm run build && vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "rehearse:migration-rollback": "node --env-file-if-exists=.env scripts/rehearse-migration-rollback.mjs",
    "rehearse:clean-environment": "node --env-file-if-exists=.env scripts/rehearse-clean-environment.mjs",
    "audit:dependencies": "node scripts/check-dependency-audit.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "rehearse:backup-restore": "node --env-file-if-exists=.env scripts/rehearse-backup-restore.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
