# Copy to .env and fill in real values. Never commit .env — only .env.example is tracked.

# PostgreSQL connection string. docker-compose.yml ships a local db matching this default.
DATABASE_URL="postgresql://app:app@localhost:5432/app"

# HMAC secret used to sign session cookies (lib/auth.ts). Generate a real one per environment with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Never reuse the same secret across environments — rotating it invalidates every session.
SESSION_SECRET="change-me-to-a-64-char-hex-secret"
