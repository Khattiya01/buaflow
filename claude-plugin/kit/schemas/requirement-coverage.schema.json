{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buaflow.dev/schemas/requirement-coverage-v1.json",
  "title": "Buaflow requirement coverage v1",
  "description": "Every accepted requirement, and the one thing that answers for it: proof, or an exception a named owner accepted until a stated date. A requirement with neither is not covered, and saying so out loud is the point of this artifact — before it existed, the only ways to ship a known accepted gap were to lie in a readiness manifest or to bury it in prose no gate reads.",
  "type": "object",
  "required": ["schemaVersion", "project", "generatedAt", "requirements"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "_": { "type": "string" },
    "project": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "requirement": {
      "type": "object",
      "required": ["id", "statement", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$" },
        "statement": { "type": "string", "minLength": 10 },
        "source": { "type": "string", "minLength": 1 },
        "proof": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "exception": { "$ref": "#/$defs/exception" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "enum": ["command", "file", "url", "manual"] },
        "value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "exception": {
      "description": "A risk somebody accepted, on a date, until a date. expiresOn is required because an exception without one is indistinguishable from a requirement nobody ever intends to meet.",
      "type": "object",
      "required": ["owner", "reason", "risk", "acceptedOn", "expiresOn"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 20 },
        "risk": { "enum": ["low", "medium", "high"] },
        "acceptedOn": { "type": "string", "format": "date" },
        "expiresOn": { "type": "string", "format": "date" },
        "compensatingControl": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
