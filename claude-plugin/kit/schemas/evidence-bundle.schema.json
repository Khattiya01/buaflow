{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buaflow.dev/schemas/evidence-bundle-v1.json",
  "title": "Buaflow evidence bundle v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "commit",
    "generatedAt",
    "readinessManifestPath",
    "reportIndexPath",
    "toolVersions",
    "summary"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "project": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "readinessManifestPath": { "type": "string", "minLength": 1 },
    "reportIndexPath": { "type": "string", "minLength": 1 },
    "toolVersions": { "$ref": "#/$defs/toolVersions" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "additionalProperties": false,
  "$defs": {
    "toolVersions": {
      "type": "object",
      "required": ["node", "platform", "arch"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "summary": {
      "type": "object",
      "required": ["level", "ok", "passed", "required"],
      "properties": {
        "level": { "enum": ["R0", "R1", "R2", "R3", "R4"] },
        "ok": { "type": "boolean" },
        "passed": { "type": "integer", "minimum": 0 },
        "required": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
