{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buaflow.dev/schemas/pack-v2.json",
  "title": "Buaflow stack/capability pack v2",
  "description": "A pack is a recipe plus a set of assertions, not a template. It names the framework-owned CLI commands to run (unpinned, so the scaffold is current rather than remembered), the configuration to apply, the files that must EXIST when the work is finished, the commands that must pass, and the readiness controls the result helps satisfy. Buaflow never stamps this code out itself: whatever model is doing the building does that, and the pack is how the result is proved. See D-011.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "name",
    "version",
    "inputs",
    "setup",
    "requiredArtifacts",
    "compatibility",
    "verification",
    "operationalEvidence"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "2.0" },
    "_": { "type": "string" },
    "_rules": { "type": "array", "items": { "type": "string" } },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "kind": { "enum": ["stack", "capability"] },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" } },
    "setup": {
      "description": "The recipe: ordered commands that produce the project, run by whoever is building. Scaffolding commands must not pin a version of the tool that owns the framework — an unpinned create-* CLI is how the result stays current, and pinning one is how a pack silently becomes a snapshot of the year it was written. Only real commands belong here; a file that is authored rather than emitted by a CLI is asserted in requiredArtifacts and nowhere else.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/setupStep" }
    },
    "requiredArtifacts": {
      "description": "Assertions, not promises: files that must be present once the work is done. In v1 this field was called generatedArtifacts and described what a generator would write, which nothing ever checked because no generator existed.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requiredArtifact" }
    },
    "implementedBy": {
      "description": "Repository-relative path to the reference app that proves this pack. When present, every requiredArtifacts path must exist under it — this is what binds a pack to something real instead of letting it describe a project nobody ever built.",
      "type": "string",
      "minLength": 1
    },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "verification": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/verificationStep" } },
    "operationalEvidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/operationalEvidence" } }
  },
  "additionalProperties": false,
  "$defs": {
    "input": {
      "type": "object",
      "required": ["name", "type", "required", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
        "type": { "enum": ["string", "boolean", "number", "enum"] },
        "required": { "type": "boolean" },
        "default": {},
        "options": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "if": { "properties": { "type": { "const": "enum" } }, "required": ["type"] },
      "then": { "required": ["options"] }
    },
    "setupStep": {
      "type": "object",
      "required": ["id", "command", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "command": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "requiredArtifact": {
      "type": "object",
      "required": ["path", "description"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": ["requiresPacks", "conflictsWithPacks", "profiles"],
      "properties": {
        "requiresPacks": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" } },
        "conflictsWithPacks": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" } },
        "profiles": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" } }
      },
      "additionalProperties": false
    },
    "verificationStep": {
      "type": "object",
      "required": ["id", "command", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "command": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "operationalEvidence": {
      "type": "object",
      "required": ["control", "evidence"],
      "properties": {
        "control": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "evidence": { "type": "string", "minLength": 20 }
      },
      "additionalProperties": false
    }
  }
}
